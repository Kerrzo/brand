---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingHero from '../../components/content/ListingHero.astro';
import FilterBar from '../../components/ui/FilterBar.astro';
import PlaceholderMedia from '../../components/ui/PlaceholderMedia.astro';
import { readingTime } from '../../lib/readingTime';
import { withBase } from '../../lib/paths';

const all = await getCollection('writing', ({ data }) => !data.draft);
const sorted = all.sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());

const featured = sorted.find((p) => p.data.featured) ?? sorted[0];
const rest = sorted.filter((p) => p.id !== featured.id);
const grid = rest.slice(0, 8);
const earlier = rest.slice(8);

const dateFmtShort = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' });
const dateFmtLong = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' });

const featuredReadingTime = readingTime(featured.body ?? '');

const categories = ['AI products', 'Creative AI', 'Architecture', 'Leadership'];
---

<BaseLayout title="Learnings" description="Notes on AI products, architecture decisions and the things that only become obvious once you ship." current="lessons">
  <ListingHero
    heading="Learnings"
    headingSize="clamp(58px, 12vw, 200px)"
    eyebrow="Learning in public"
    meta={`No content calendar.\nOnly lessons worth writing down.`}
    lede={`<p>Building raises questions.</p><p>Writing helps me answer them.</p><p><strong>These are notes from AI products, architecture decisions and experiments that changed how I think.</strong></p>`}
  />

  <section class="container writing-page__filter">
    <FilterBar categories={categories} allLabel="All" />
  </section>

  {featured && (
    <section class="container writing-page__featured" data-card data-cat={featured.data.category}>
      <a href={withBase(`/lessons/${featured.id}/`)} class="writing-page__featured-grid" data-reveal>
        <div class="writing-page__featured-media-wrap">
          <PlaceholderMedia label="Hero image · replace" src={featured.data.heroImage} alt={featured.data.heroAlt} ratio="16/9" radius="lg" />
          <span class="writing-page__featured-badge">Featured</span>
        </div>
        <div class="writing-page__featured-copy">
          <span class="pill-tag">{featured.data.category}</span>
          <h2 class="writing-page__featured-title">{featured.data.title}</h2>
          <p class="body-copy" style="margin:0;max-width:44ch">{featured.data.description}</p>
          <div class="writing-page__featured-meta">
            <span>{dateFmtLong.format(featured.data.publishedDate)}</span>
            <span>&middot;</span>
            <span>{featuredReadingTime}</span>
          </div>
        </div>
      </a>
    </section>
  )}

  <section class="container writing-page__grid-wrap">
    <div class="writing-page__grid" data-narrow="repeat(2,minmax(0,1fr))" data-reveal>
      {grid.map((post) => (
        <a href={withBase(`/lessons/${post.id}/`)} class="writing-page__card" data-card data-cat={post.data.category}>
          <PlaceholderMedia label="Image" src={post.data.heroImage} alt={post.data.heroAlt} ratio="4/3" radius="md" />
          <span class="pill-tag">{post.data.category}</span>
          <h3 class="writing-page__card-title">{post.data.title}</h3>
          <span class="mono-label">{dateFmtShort.format(post.data.publishedDate)}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="writing-page__pause" data-writing-pause aria-label="Building in public">
    <div class="writing-page__pause-inner">
      <div class="writing-page__pause-statement">
        <p data-pause-line data-pause-emphasis>Everything on this site comes from real projects, real experiments and real decisions.</p>
        <p data-pause-line data-pause-emphasis>Sometimes the ideas survive.</p>
        <p data-pause-line data-pause-emphasis>Sometimes they don&rsquo;t.</p>
        <p data-pause-line data-pause-emphasis>Both are worth documenting.</p>
      </div>
    </div>
  </section>

  {earlier.length > 0 && (
    <section class="container writing-page__earlier">
      <div class="writing-page__earlier-intro" data-reveal>
        <h2 class="writing-page__earlier-heading">Earlier notes</h2>
        <span class="mono-label">
          ({earlier[earlier.length - 1].data.publishedDate.getFullYear()} — {earlier[0].data.publishedDate.getFullYear()})
        </span>
      </div>
      <div class="writing-page__earlier-rows" data-reveal>
        {earlier.map((post) => (
          <a href={withBase(`/lessons/${post.id}/`)} class="writing-page__earlier-row" data-card data-cat={post.data.category}>
            <h3 class="writing-page__earlier-title">{post.data.title}</h3>
            <span class="writing-page__earlier-desc">{post.data.description}</span>
            <span class="mono-label" style="color:var(--color-label-dim);text-align:right">{dateFmtShort.format(post.data.publishedDate)}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .writing-page__filter {
    padding-top: clamp(40px, 6vh, 72px);
  }

  .writing-page__featured {
    padding-top: clamp(40px, 6vh, 72px);
  }

  .writing-page__featured-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
  }

  .writing-page__featured-media-wrap {
    position: relative;
  }

  .writing-page__featured-badge {
    position: absolute;
    left: 24px;
    top: 22px;
    background: var(--color-accent);
    color: #fff;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: 500;
  }

  .writing-page__featured-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-bottom: 6px;
    align-items: flex-start;
  }

  .writing-page__featured-title {
    margin: 0;
    font-size: clamp(28px, 3.2vw, 50px);
    line-height: 1.02;
    letter-spacing: -.035em;
    font-weight: 500;
    max-width: 18ch;
  }

  .writing-page__featured-meta {
    display: flex;
    gap: 18px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--color-label);
  }

  .writing-page__grid-wrap {
    padding-top: clamp(56px, 8vh, 100px);
  }

  .writing-page__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(18px, 2.2vw, 34px);
  }

  .writing-page__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }

  .writing-page__card-title {
    margin: 0;
    font-size: 21px;
    line-height: 1.15;
    letter-spacing: -.025em;
    font-weight: 500;
  }

  .writing-page__earlier {
    padding-top: clamp(80px, 12vh, 160px);
    padding-bottom: clamp(80px, 12vh, 160px);
  }

  .writing-page__earlier-intro {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 26px;
  }

  .writing-page__earlier-heading {
    margin: 0;
    font-size: clamp(28px, 3.2vw, 50px);
    line-height: 1;
    letter-spacing: -.04em;
    font-weight: 500;
  }

  .writing-page__earlier-rows {
    border-top: 1px solid var(--color-border);
  }

  .writing-page__earlier-row {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) 120px;
    gap: 24px;
    align-items: baseline;
    padding: 26px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .writing-page__earlier-title {
    margin: 0;
    font-size: clamp(20px, 2.2vw, 32px);
    font-weight: 500;
    letter-spacing: -.03em;
    line-height: 1.08;
    max-width: 22ch;
  }

  .writing-page__earlier-desc {
    font-size: 15px;
    color: var(--color-body);
    line-height: 1.55;
  }

  .writing-page__pause {
    margin: clamp(72px, 11vh, 140px) 0 0;
    background: var(--color-dark-bg);
    color: var(--color-dark-fg);
  }

  .writing-page__pause-inner {
    padding: clamp(88px, 16vh, 180px) var(--edge);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .writing-page__pause-statement {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45em;
    width: 100%;
    font-size: clamp(30px, 4.6vw, 64px);
    max-width: min(28em, 92vw);
  }

  .writing-page__pause-statement p {
    margin: 0;
    font-size: 1em;
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 500;
    opacity: 0.14;
    transition: opacity 0.55s ease;
  }

  @media (max-width: 900px) {
    .writing-page__featured-grid,
    .writing-page__earlier-row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 16px;
    }

    .writing-page__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .writing-page__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  function initWritingPause() {
    const section = document.querySelector<HTMLElement>('[data-writing-pause]');
    if (!section || section.dataset.pauseReady === 'true') return;
    section.dataset.pauseReady = 'true';

    const lines = Array.from(section.querySelectorAll<HTMLElement>('[data-pause-line]'));
    if (!lines.length) return;

    let raf: number | null = null;

    const update = () => {
      raf = null;
      const focusY = window.innerHeight * 0.55;
      const sectionRect = section.getBoundingClientRect();
      if (sectionRect.bottom < 0 || sectionRect.top > window.innerHeight) return;

      let active = 0;
      let best = Infinity;
      lines.forEach((el, i) => {
        const r = el.getBoundingClientRect();
        const mid = r.top + r.height / 2;
        const dist = Math.abs(mid - focusY);
        if (dist < best) {
          best = dist;
          active = i;
        }
      });

      lines.forEach((el, i) => {
        const emphasized = el.hasAttribute('data-pause-emphasis');
        if (i === active) {
          el.style.opacity = emphasized ? '1' : '0.85';
        } else if (i < active) {
          el.style.opacity = emphasized ? '0.38' : '0.45';
        } else {
          el.style.opacity = emphasized ? '0.14' : '0.28';
        }
      });
    };

    const onScroll = () => {
      if (raf == null) raf = requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }

  initWritingPause();
  document.addEventListener('astro:after-swap', () => {
    document.querySelectorAll<HTMLElement>('[data-writing-pause]').forEach((el) => {
      delete el.dataset.pauseReady;
    });
    initWritingPause();
  });
</script>
