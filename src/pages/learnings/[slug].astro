---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlaceholderMedia from '../../components/ui/PlaceholderMedia.astro';
import FinalCTA from '../../components/ui/FinalCTA.astro';
import ArticleTwoCol from '../../components/content/article/ArticleTwoCol.astro';
import { readingTime } from '../../lib/readingTime';

export async function getStaticPaths() {
  const items = await getCollection('writing', ({ data }) => !data.draft);
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const minutes = readingTime(item.body ?? '');
const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const rich = item.data.richLayout;
---

<BaseLayout title={item.data.title} description={item.data.description} current="learnings">
  <div class:list={['article-frame', 'container', { 'article-frame--rich': rich }]}>
    <a href="/learnings/" class="article__back">&larr; Learnings</a>

    <div class="article__intro" data-reveal>
      <ArticleTwoCol>
        <span slot="label" class="pill-tag">{item.data.category}</span>
        <div class="article__intro-main">
          <div class="article__intro-copy">
            <h1 class="article__heading">{item.data.title}</h1>
            <p class="article__deck">{item.data.description}</p>
            <div class="article__meta">
              <span>{dateFmt.format(item.data.publishedDate)}</span>
              <span>&middot;</span>
              <span>{minutes}</span>
              {item.data.placeholder && (
                <>
                  <span>&middot;</span>
                  <span class="article__placeholder-flag">Placeholder &mdash; full piece coming soon</span>
                </>
              )}
            </div>
          </div>
          <figure class="article__hero-figure">
            <PlaceholderMedia
              label={item.data.heroMediaLabel ?? 'Hero image · replace'}
              src={item.data.heroImage}
              alt={item.data.heroAlt}
              ratio="16/9"
              radius="lg"
              class="article__hero"
            />
            {item.data.heroCaption && <figcaption class="article__hero-caption">{item.data.heroCaption}</figcaption>}
          </figure>
        </div>
      </ArticleTwoCol>
    </div>
  </div>

  {rich ? (
    <div class="article-body" data-reveal>
      <Content />
    </div>
  ) : (
    <div class="container">
      <div class="prose" data-reveal>
        <Content />
      </div>
    </div>
  )}

  <FinalCTA />
</BaseLayout>

<style>
  .article-frame {
    max-width: 900px;
    padding-top: clamp(120px, 18vh, 200px);
    padding-bottom: clamp(40px, 6vh, 72px);
  }

  .article-frame--rich {
    max-width: none;
  }

  .article__back {
    display: inline-flex;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-label);
    margin-bottom: clamp(28px, 4vh, 48px);
  }

  .article__back:hover {
    color: var(--color-accent);
  }

  .article__intro {
    margin-bottom: 0;
  }

  .article__intro-main {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
    width: 100%;
  }

  .article__intro-copy {
    display: flex;
    flex-direction: column;
    gap: 30px;
    align-items: flex-start;
    padding-right: clamp(0px, 2vw, 24px);
  }

  .article__heading {
    margin: 0;
    font-size: clamp(34px, 5.4vw, 64px);
    line-height: 1.06;
    letter-spacing: -.04em;
    font-weight: 500;
  }

  .article__deck {
    margin: 0;
    font-size: 19px;
    line-height: 1.55;
    color: var(--color-body);
    max-width: 42ch;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--color-label);
  }

  .article__placeholder-flag {
    color: var(--color-accent);
  }

  .article__hero-figure {
    margin: 0;
    min-width: 0;
  }

  .article__hero-caption {
    margin-top: 16px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-body);
    max-width: 52ch;
  }

  .article-body {
    margin-top: clamp(64px, 9vh, 110px);
  }

  @media (max-width: 900px) {
    .article__intro-main {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
