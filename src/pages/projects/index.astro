---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingHero from '../../components/content/ListingHero.astro';
import PlaceholderMedia from '../../components/ui/PlaceholderMedia.astro';
import FinalCTA from '../../components/ui/FinalCTA.astro';

const all = await getCollection('projects', ({ data }) => !data.draft);
const items = all.sort((a, b) => a.data.displayOrder - b.data.displayOrder);
---

<BaseLayout title="Products and Experiments" description="I build my own products to explore what experienced, AI-enabled creators and small teams can now achieve." current="projects">
  <ListingHero
    heading="Products and experiments"
    headingSize="clamp(48px, 9vw, 160px)"
    eyebrow="What I'm building now"
    meta={`${items.length} in progress · updated as they ship`}
    lede="I build my own products to explore what experienced, AI-enabled creators and small teams can now achieve."
  />

  <section class="container projects-page__rows">
    {items.map((item, i) => (
      <div class:list={['projects-page__row', { 'projects-page__row--dark': i % 2 === 1 }]} data-reveal>
        <PlaceholderMedia
          label={`${item.data.title} hero image`}
          src={item.data.heroImage}
          alt={item.data.heroAlt}
          ratio="16/11"
          radius="md"
          dark={i % 2 === 1}
          class="projects-page__media"
        />
        <div class="projects-page__copy">
          <div class:list={['mono-label', { 'eyebrow--dark': i % 2 === 1 }]}>({String(i + 1).padStart(2, '0')}) &middot; {item.data.status}</div>
          <h2 class="projects-page__title">{item.data.title}</h2>
          <div class="projects-page__tagline">{item.data.tagline}</div>
          <p class="projects-page__desc">{item.data.description}</p>
          <div class="projects-page__tags">
            {item.data.tags.map((tag) => <span class:list={['pill-tag', { 'pill-tag--dark': i % 2 === 1 }]}>{tag}</span>)}
          </div>
          <a href={`/projects/${item.id}/`} class="projects-page__link">View project &rarr;</a>
        </div>
      </div>
    ))}
  </section>

  <FinalCTA />
</BaseLayout>

<style>
  .projects-page__rows {
    padding-top: clamp(60px, 9vh, 120px);
    display: flex;
    flex-direction: column;
    gap: clamp(60px, 9vh, 120px);
  }

  .projects-page__row {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 72px);
    align-items: center;
  }

  .projects-page__row--dark {
    background: var(--color-dark-bg);
    color: var(--color-dark-fg);
    border-radius: var(--radius-xl);
    padding: clamp(36px, 5vw, 64px);
  }

  .projects-page__copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .projects-page__title {
    margin: 0;
    font-size: clamp(30px, 3.6vw, 52px);
    line-height: .98;
    letter-spacing: -.035em;
    font-weight: 500;
  }

  .projects-page__tagline {
    font-size: 17px;
    font-weight: 500;
  }

  .projects-page__desc {
    margin: 0;
    max-width: 42ch;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-body);
  }

  .projects-page__row--dark .projects-page__desc {
    color: rgba(243, 242, 240, .62);
  }

  .projects-page__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .projects-page__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 500;
    border-bottom: 1px solid var(--color-border-strong);
    padding-bottom: 4px;
    align-self: flex-start;
    margin-top: 4px;
  }

  .projects-page__row--dark .projects-page__link {
    border-bottom-color: rgba(243, 242, 240, .3);
  }

  @media (max-width: 900px) {
    .projects-page__row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 20px;
    }
  }
</style>
