---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';

export async function getStaticPaths() {
  const items = await getCollection('projects', ({ data }) => !data.draft);
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const facts = [
  { label: 'Status', value: item.data.status },
  ...(item.data.tags.length ? [{ label: 'Focus', value: item.data.tags.join(', ') }] : []),
  ...(item.data.externalUrl ? [{ label: 'Link', value: item.data.externalUrl }] : []),
];
---

<ContentLayout
  title={item.data.title}
  description={item.data.description}
  current="projects"
  eyebrow={item.data.status}
  heading={item.data.title}
  tagline={item.data.tagline}
  backHref="/projects/"
  backLabel="All projects"
  heroLabel={`${item.data.title} hero image`}
  heroImage={item.data.heroImage}
  heroAlt={item.data.heroAlt}
  facts={facts}
>
  <Content />
</ContentLayout>
