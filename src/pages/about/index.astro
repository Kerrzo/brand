---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlaceholderMedia from '../../components/ui/PlaceholderMedia.astro';
import FinalCTA from '../../components/ui/FinalCTA.astro';
import EditorialScrollSequence from '../../components/ui/EditorialScrollSequence.astro';

const contexts = ['Craveable Brands', 'International Towers', 'Amica', '42 Interactive', 'BoxOfficeVR'];

const timeline = [
  {
    n: '001',
    title: 'Enterprise Platforms',
    copy: 'Designed and delivered large-scale software platforms used by millions of customers.',
    year: '',
  },
  {
    n: '002',
    title: 'Product & Technology Leadership',
    copy: 'Led engineering teams while remaining deeply involved in architecture and product design.',
    year: '',
  },
  {
    n: '003',
    title: 'Founder & Builder',
    copy: 'Built products across enterprise software, AI, VR and consumer applications.',
    year: '',
  },
  {
    n: '004',
    title: 'Today',
    copy: 'Exploring AI-native products, modern engineering workflows and the future of software.',
    year: '',
  },
];

const capabilities = [
  {
    title: 'Build before debating',
    copy: 'The fastest way to understand new technology is to build something real.',
  },
  {
    title: 'Architecture outlives models',
    copy: 'Models improve constantly. Good architecture survives those changes.',
  },
  {
    title: 'Keep the human answer intact',
    copy: 'AI should amplify judgement, not replace it.',
  },
  {
    title: 'Ship. Learn. Repeat.',
    copy: 'Real products teach lessons that theory never will.',
  },
];

const beliefs = [
  {
    n: '01',
    title: 'The model is rarely the hard part.',
    copy: 'Choosing where intelligence belongs is usually the harder architectural decision.',
  },
  {
    n: '02',
    title: 'Prototype early.',
    copy: 'Real software exposes assumptions much faster than planning.',
  },
  {
    n: '03',
    title: 'Curiosity compounds.',
    copy: 'The best opportunities come from following interesting technical questions.',
  },
  {
    n: '04',
    title: 'Learn in public.',
    copy: 'Sharing experiments creates better conversations than polished opinions.',
  },
];
---

<BaseLayout
  title="About Paul"
  description="Thirty years of building software. Still learning — and documenting what AI changes along the way."
  current="about"
>
  <section id="top" class="page-hero container">
    <h1 class="page-hero__heading">About Paul</h1>
    <div class="page-hero__grid">
      <div class="page-hero__meta">
        <div class="mono-label">About Paul</div>
        <div class="page-hero__meta-copy">
          <p>Engineer.</p>
          <p>Product Architect.</p>
          <p>Builder.</p>
          <p class="page-hero__meta-gap">Thirty years of building software.</p>
          <p>Still learning.</p>
        </div>
      </div>
      <div class="page-hero__lede">
        <p><strong>Thirty years of engineering taught me how to build software.</strong></p>
        <p>Now I&rsquo;m exploring what becomes possible when experience meets AI.</p>
        <p>The tools are changing, the principles aren&rsquo;t.</p>
      </div>
    </div>
  </section>

  <section class="container about-photos">
    <div class="about-photos__grid" data-reveal>
      <div class="about-photos__frame">
        <PlaceholderMedia label="Editorial portrait" ratio="16/10" radius="md" dark />
        <div class="about-photos__caption">
          Now building.<br />
          AI-native products and experiments.
        </div>
      </div>
      <div class="about-photos__frame">
        <PlaceholderMedia label="Workspace" ratio="16/10" radius="md" />
        <div class="about-photos__caption about-photos__caption--light">
          Workspace.<br />
          Where ideas become software.
        </div>
      </div>
    </div>
  </section>

  <section class="container about-contexts">
    <div class="about-contexts__meta" data-reveal>
      <span class="about-contexts__meta-left"><span class="dot" aria-hidden="true"></span>Selected contexts</span>
      <span>(1999 — 2026)</span>
    </div>
    <div class="about-contexts__grid" data-reveal data-narrow="repeat(2,minmax(0,1fr))">
      {contexts.map((c) => <div class="about-contexts__item">{c}</div>)}
    </div>
  </section>

  <section class="container about-short">
    <div class="about-short__grid" data-reveal>
      <div class="mono-label about-short__label">The short version</div>
      <div class="about-short__body">
        <h2 class="about-short__heading">
          I started as an engineer. Thirty years later, I&rsquo;m still learning.
        </h2>
        <div class="about-short__cols">
          <div class="about-short__col body-copy">
            <p>I started writing software in the 1990s because I loved building things.</p>
            <p>
              Since then I&rsquo;ve designed enterprise platforms, led engineering teams, built
              startups and helped organisations solve difficult technical problems.
            </p>
            <p>Today I&rsquo;m fascinated by something different.</p>
          </div>
          <div class="about-short__col body-copy">
            <p>AI isn&rsquo;t simply another technology shift.</p>
            <p>It changes how products are conceived, designed and built.</p>
            <p>This website documents what I&rsquo;m learning as I explore that change.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container about-timeline">
    <div class="about-timeline__intro" data-reveal>
      <h2 class="about-timeline__heading">Selected Experience</h2>
      <span class="mono-label">(04)</span>
    </div>
    <div class="about-timeline__rows" data-reveal>
      {timeline.map((row) => (
        <div class="about-timeline__row" data-narrow="minmax(0,1fr) 90px">
          <span class="mono-label" style="color:var(--color-label-dim)">{row.n}</span>
          <span class="about-timeline__title">{row.title}</span>
          <span class="about-timeline__copy">{row.copy}</span>
          <span class="mono-label" style="color:var(--color-label);text-align:right">{row.year}</span>
        </div>
      ))}
    </div>
  </section>

  <EditorialScrollSequence
    lines={[
      'Experience tells me what used to work.',
      'Curiosity helps me discover what works next.',
    ]}
  />

  <section class="container about-beliefs">
    <div class="about-beliefs__intro" data-reveal>
      <div>
        <div class="mono-label" style="margin-bottom:24px">What I believe</div>
        <h2 class="about-beliefs__heading">Principles</h2>
      </div>
    </div>
    <div class="about-beliefs__rows" data-reveal>
      {beliefs.map((b) => (
        <div class="about-beliefs__row">
          <span class="mono-label" style="color:var(--color-label-dim)">{b.n}</span>
          <h3 class="about-beliefs__title">{b.title}</h3>
          <p class="about-beliefs__copy">{b.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="about-capabilities">
    <div class="container">
      <div class="about-capabilities__intro" data-reveal>
        <div class="mono-label" style="color:var(--color-dark-label)">Approach</div>
        <h2 class="about-capabilities__heading">How I Think</h2>
      </div>
      <div class="about-capabilities__grid" data-reveal>
        {capabilities.map((c) => (
          <div class="about-capabilities__item">
            <div class="about-capabilities__item-title">{c.title}</div>
            <div class="about-capabilities__item-copy">{c.copy}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container about-away">
    <div class="about-away__grid" data-reveal>
      <PlaceholderMedia
        label="Lifestyle photography · Chess · Workspace · Running"
        ratio="4/5"
        radius="md"
      />
      <div class="about-away__copy">
        <div class="mono-label">Away from the screen</div>
        <h2 class="about-away__heading">Beyond software</h2>
        <div class="about-away__body body-copy" style="max-width:46ch">
          <p>Outside of work I&rsquo;m usually exploring another system.</p>
          <p>Chess.</p>
          <p>Game development.</p>
          <p>Running.</p>
          <p>Virtual reality.</p>
          <p>Creative tools.</p>
          <p>Most of those hobbies eventually become experiments.</p>
          <p>Most experiments eventually become products.</p>
        </div>
        <div class="about-away__tags">
          {['Chess', 'Game development', 'Running', 'Virtual reality', 'Creative tools'].map((t) => (
            <span class="pill-tag" style="padding:9px 16px;font-size:14px">{t}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <FinalCTA />
</BaseLayout>

<style>
  .page-hero {
    padding-top: clamp(120px, 20vh, 220px);
  }

  .page-hero__heading {
    margin: 0;
    font-size: clamp(64px, 13vw, 220px);
    line-height: 0.86;
    letter-spacing: -0.055em;
    font-weight: 500;
    max-width: 15ch;
  }

  .page-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.45fr);
    gap: clamp(24px, 5vw, 90px);
    margin-top: clamp(34px, 6vh, 68px);
  }

  .page-hero__meta {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .page-hero__meta-copy {
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-body);
    max-width: 26ch;
  }

  .page-hero__meta-copy p {
    margin: 0;
  }

  .page-hero__meta-gap {
    margin-top: 0.85em !important;
  }

  .page-hero__lede {
    display: flex;
    flex-direction: column;
    gap: 1em;
    margin: 0;
    font-size: clamp(19px, 1.9vw, 28px);
    line-height: 1.36;
    letter-spacing: -0.02em;
    max-width: 44ch;
  }

  .page-hero__lede p {
    margin: 0;
  }

  .about-photos {
    padding-top: clamp(48px, 8vh, 96px);
  }

  .about-photos__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(16px, 2vw, 28px);
  }

  .about-photos__frame {
    position: relative;
  }

  .about-photos__caption {
    position: absolute;
    left: 26px;
    bottom: 24px;
    color: #fff;
    font-size: clamp(18px, 1.8vw, 26px);
    font-weight: 500;
    letter-spacing: -.025em;
    line-height: 1.15;
    max-width: 18ch;
  }

  .about-photos__caption--light {
    max-width: 16ch;
    color: var(--color-ink);
  }

  .about-contexts {
    padding-top: clamp(60px, 9vh, 120px);
  }

  .about-contexts__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--color-label);
  }

  .about-contexts__meta-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .about-contexts__meta-left .dot {
    width: 6px;
    height: 6px;
  }

  .about-contexts__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .about-contexts__item {
    padding: 26px 18px;
    text-align: center;
    font-size: 16px;
    font-weight: 500;
    border-right: 1px solid var(--color-border);
  }

  .about-contexts__item:last-child {
    border-right: none;
  }

  .about-short {
    padding-top: clamp(90px, 13vh, 180px);
  }

  .about-short__grid {
    display: grid;
    grid-template-columns: minmax(0, .5fr) minmax(0, 1.5fr);
    gap: clamp(24px, 4vw, 72px);
    align-items: start;
  }

  .about-short__label {
    padding-top: 12px;
  }

  .about-short__body {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .about-short__heading {
    margin: 0;
    font-size: clamp(30px, 3.6vw, 58px);
    line-height: 1.04;
    letter-spacing: -.035em;
    font-weight: 500;
    max-width: 22ch;
    text-wrap: pretty;
  }

  .about-short__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 56px);
  }

  .about-short__col {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .about-short__col p {
    margin: 0;
  }

  .about-timeline {
    padding-top: clamp(80px, 11vh, 150px);
  }

  .about-timeline__intro {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 34px;
  }

  .about-timeline__heading {
    margin: 0;
    font-size: clamp(34px, 4.6vw, 74px);
    line-height: .96;
    letter-spacing: -.045em;
    font-weight: 500;
  }

  .about-timeline__rows {
    border-top: 1px solid var(--color-border);
  }

  .about-timeline__row {
    display: grid;
    grid-template-columns: 90px minmax(0, 1.1fr) minmax(0, 1.2fr) 120px;
    gap: 20px;
    align-items: baseline;
    padding: 26px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .about-timeline__title {
    font-size: clamp(19px, 1.9vw, 28px);
    font-weight: 500;
    letter-spacing: -.025em;
  }

  .about-timeline__copy {
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-body);
  }

  .about-capabilities {
    margin-top: clamp(90px, 13vh, 180px);
    background: var(--color-dark-bg);
    color: var(--color-dark-fg);
    padding: clamp(64px, 10vh, 140px) 0;
  }

  .about-capabilities__intro {
    display: grid;
    grid-template-columns: minmax(0, .5fr) minmax(0, 1.5fr);
    gap: clamp(24px, 4vw, 72px);
    align-items: start;
    margin-bottom: clamp(40px, 6vh, 80px);
  }

  .about-capabilities__heading {
    margin: 0;
    font-size: clamp(30px, 3.6vw, 58px);
    line-height: 1.04;
    letter-spacing: -.035em;
    font-weight: 500;
    max-width: 20ch;
  }

  .about-capabilities__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-dark-border);
  }

  .about-capabilities__item {
    padding: 28px 24px;
    border-bottom: 1px solid var(--color-dark-border);
    border-right: 1px solid var(--color-dark-border);
  }

  .about-capabilities__item:nth-child(3n) {
    border-right: none;
  }

  .about-capabilities__item-title {
    font-size: 19px;
    font-weight: 500;
    margin-bottom: 8px;
  }

  .about-capabilities__item-copy {
    font-size: 15px;
    line-height: 1.55;
    color: rgba(243, 242, 240, .55);
  }

  .about-beliefs {
    padding-top: clamp(90px, 13vh, 180px);
  }

  .about-beliefs__intro {
    margin-bottom: clamp(36px, 5vh, 64px);
  }

  .about-beliefs__heading {
    margin: 0;
    font-size: clamp(34px, 5vw, 80px);
    line-height: .94;
    letter-spacing: -.045em;
    font-weight: 500;
    max-width: 14ch;
  }

  .about-beliefs__rows {
    border-top: 1px solid var(--color-border);
  }

  .about-beliefs__row {
    display: grid;
    grid-template-columns: 90px minmax(0, 1.05fr) minmax(0, 1.1fr);
    gap: 24px;
    align-items: baseline;
    padding: 30px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .about-beliefs__title {
    margin: 0;
    font-size: clamp(22px, 2.4vw, 38px);
    font-weight: 500;
    letter-spacing: -.03em;
    line-height: 1.05;
    max-width: 18ch;
  }

  .about-beliefs__copy {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-body);
    max-width: 46ch;
  }

  .about-away {
    padding-top: clamp(90px, 13vh, 180px);
  }

  .about-away__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
    gap: clamp(28px, 5vw, 90px);
    align-items: center;
  }

  .about-away__copy {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .about-away__heading {
    margin: 0;
    font-size: clamp(28px, 3.2vw, 50px);
    line-height: 1.04;
    letter-spacing: -.035em;
    font-weight: 500;
    max-width: 18ch;
  }

  .about-away__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .about-away__body p {
    margin: 0;
  }

  .about-away__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 900px) {
    .page-hero__grid,
    .about-photos__grid,
    .about-short__grid,
    .about-short__cols,
    .about-capabilities__intro,
    .about-away__grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 20px;
    }

    .about-contexts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about-timeline__row {
      grid-template-columns: minmax(0, 1fr) 90px;
      row-gap: 6px;
    }

    .about-timeline__copy {
      display: none;
    }

    .about-capabilities__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .about-capabilities__item {
      border-right: none;
    }

    .about-beliefs__row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 10px;
    }
  }
</style>
