---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentLayout from '../../layouts/ContentLayout.astro';
import FinalCTA from '../../components/ui/FinalCTA.astro';
import SectionLabel from '../../components/ui/SectionLabel.astro';
import ArticleTwoCol from '../../components/content/article/ArticleTwoCol.astro';

export async function getStaticPaths() {
  const items = await getCollection('work', ({ data }) => !data.draft);
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const rich = item.data.richLayout;

// Only render real related Learnings — never a placeholder or invented link.
const relatedWriting = item.data.relatedWriting.length
  ? (await getCollection('writing', ({ data }) => !data.draft)).filter((post) =>
      item.data.relatedWriting.includes(post.id)
    )
  : [];

// Non-rich entries keep the original generic ContentLayout treatment.
const facts = [
  { label: 'Client', value: item.data.client },
  { label: 'Category', value: item.data.category },
  { label: 'Years', value: item.data.yearRange },
  ...(item.data.role ? [{ label: 'Role', value: item.data.role }] : []),
  ...(item.data.deliveredVia ? [{ label: 'Delivered via', value: item.data.deliveredVia }] : []),
  ...(item.data.tags.length ? [{ label: 'Focus', value: item.data.tags.join(', ') }] : []),
];
---

{rich ? (
  <BaseLayout title={item.data.title} description={item.data.description} current="shipped">
    <div class="case-frame container">
      <div class="case__intro" data-reveal>
        <ArticleTwoCol>
          <SectionLabel slot="label" withDot>{item.data.eyebrow ?? item.data.tagline}</SectionLabel>
          <h1 class="case__heading">{item.data.title}</h1>
          <p class="case__deck">{item.data.description}</p>

          <div class="case__meta">
            {item.data.meta.map((line) => <span class="case__meta-line">{line}</span>)}
          </div>
        </ArticleTwoCol>
      </div>
    </div>

    <div class="case-body">
      <Content />
    </div>

    {relatedWriting.length > 0 && (
      <div class="container case-related">
        <div class="mono-label">Related learnings</div>
        <ul class="case-related__list">
          {relatedWriting.map((post) => (
            <li>
              <a href={`/learnings/${post.id}/`} class="case-related__link">{post.data.title} &rarr;</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <FinalCTA />
  </BaseLayout>
) : (
  <ContentLayout
    title={item.data.title}
    description={item.data.description}
    current="shipped"
    eyebrow={item.data.category}
    heading={item.data.title}
    tagline={item.data.tagline}
    backHref="/shipped/"
    backLabel="All selected work"
    heroLabel={`${item.data.client} · ${item.data.tagline}`}
    heroImage={item.data.heroImage}
    heroAlt={item.data.heroAlt}
    facts={facts}
  >
    <Content />
  </ContentLayout>
)}

<style>
  .case-frame {
    padding-top: clamp(120px, 18vh, 200px);
    padding-bottom: clamp(56px, 8vh, 96px);
  }

  .case__intro {
    margin-bottom: 40px;
  }

  .case__intro :global(.article-two-col__content) {
    gap: 22px;
  }

  .case__intro :global(.article-two-col__content) > :global(* + *) {
    margin-top: 0;
  }

  .case__heading {
    margin: 0;
    font-size: clamp(44px, 7vw, 96px);
    line-height: .94;
    letter-spacing: -.045em;
    font-weight: 500;
  }

  .case__deck {
    margin: 0;
    font-size: clamp(19px, 1.9vw, 25px);
    line-height: 1.45;
    letter-spacing: -.01em;
    color: var(--color-ink-soft);
    max-width: 62ch;
  }

  .case__meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 10px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
    width: 100%;
    max-width: 44ch;
  }

  .case__meta-line {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--color-label);
  }

  .case-body {
    margin-top: 0;
  }

  /* The rich body's first section (.article-section) already carries its own
     padding-block — this fixed override keeps the hero-to-first-chapter gap
     a deliberate ~80-120px regardless of viewport height, instead of the
     vh-scaled padding every other chapter uses (which is what made the
     opening balloon on tall screens). */
  .case-body :global(#the-beginning) {
    padding-top: 56px;
  }

  .case-related {
    padding-block: clamp(56px, 8vh, 96px);
  }

  .case-related__list {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .case-related__link {
    font-size: 18px;
    font-weight: 500;
  }

  .case-related__link:hover {
    color: var(--color-accent);
  }
</style>
