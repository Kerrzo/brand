---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingHero from '../../components/content/ListingHero.astro';
import FilterBar from '../../components/ui/FilterBar.astro';
import PlaceholderMedia from '../../components/ui/PlaceholderMedia.astro';
import VideoReveal from '../../components/ui/VideoReveal.astro';
import EditorialScrollSequence from '../../components/ui/EditorialScrollSequence.astro';
import FinalCTA from '../../components/ui/FinalCTA.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('work', ({ data }) => !data.draft);
const items = all.sort((a, b) => a.data.displayOrder - b.data.displayOrder);
const showShowreel = false;

const categories = ['AI Strategy Platform', 'Enterprise platforms', 'Immersive technology', 'Health and wellbeing'];

const takeaways = [
  {
    n: '01',
    title: 'Scale changes the architecture.',
    copy: 'Once a platform reaches every store, lobby or clinical site, architecture decisions stop being theoretical — reliability and operations become the product.',
  },
  {
    n: '02',
    title: "Every industry thinks it's unique. The engineering usually isn't.",
    copy: 'Commerce, property, strategy, healthcare and immersive work look different on the surface. Underneath, they share the same need: software that survives real operations.',
  },
  {
    n: '03',
    title: 'Products succeed when the whole system works—not just the app.',
    copy: 'The useful work sat between strategy and delivery — holding product judgement and technical clarity in the same place from first decision through to ship.',
  },
  {
    n: '04',
    title: 'Real products depend on ecosystems, integrations and operational reality.',
    copy: 'Much of this client work shipped through 42 Interactive — senior architecture and product thinking inside a team accountable for getting it live.',
  },
];
---

<BaseLayout title="Shipped" description="Products I've helped build and put into the world. What happened after they shipped is part of the story." current="shipped">
  <ListingHero
    heading="Shipped."
    eyebrowTop="Built & Delivered"
    eyebrow="Selected work"
    meta="Five stories."
    lede={`<p>Products I&rsquo;ve helped build and put into the world.</p><p>What happened after they shipped is part of the story.</p>`}
  />

  <section class="container work-filter">
    <FilterBar categories={categories} allLabel="All work" />
  </section>

  <section class="container work-rows" data-card-group>
    {items.slice(0, 3).map((item, i) => {
      const href = item.id === 'international-towers-amica' ? '/shipped/amica/' : `/shipped/${item.id}/`;
      return (
        <article class:list={['work-row', { 'work-row--dark': i % 2 === 0 }]} data-card data-cat={item.data.category} data-reveal>
          <a href={href} aria-label={`Read ${item.data.title}`}>
            {item.id === 'international-towers-amica' ? (
              <img class="work-row__natural-image" src={item.data.heroImage} alt={item.data.heroAlt} loading="lazy" />
            ) : (
              <PlaceholderMedia src={item.data.heroImage} alt={item.data.heroAlt} label={`${item.data.client} · ${item.data.tagline}`} ratio="16/11" radius="md" />
            )}
          </a>
          <div class="work-row__copy" data-listing-copy>
            <div class:list={['mono-label', { 'eyebrow--dark': i % 2 === 0 }]}>{String(i + 1).padStart(2, '0')} · {item.data.category} · {item.data.yearRange}</div>
            <h2 class="work-row__title">{item.data.title}</h2>
            <div class="work-row__tagline">{item.data.tagline}</div>
            <p class="work-row__desc">{item.data.description}</p>
            <div class="work-row__tags">{item.data.tags.map(tag => <span class:list={['pill-tag', { 'pill-tag--dark': i % 2 === 0 }]}>{tag}</span>)}</div>
            <a href={href} class="work-row__link" data-listing-link>Read Case Study →</a>
          </div>
        </article>
      );
    })}
  </section>
  <EditorialScrollSequence
    tone="light"
    lines={[
      'The best products aren’t interesting because of the technology.',
      'They’re interesting because people actually use them.',
    ]}
  />

  {showShowreel && <section class="container work-showreel">
    <div class="work-showreel__intro" data-reveal>
      <div class="mono-label">Showreel</div>
    </div>
    <VideoReveal posterLabel="Short walkthroughs showing how these products behaved after launch—not just how they looked in Figma." />
  </section>}

  {items.length > 3 && (
    <section class="work-dark-group" data-card-group>
      <div class="container">
        <div class="work-dark-group__meta" data-reveal>
          <span>004 / 005 &mdash; Beyond the screen</span>
          <span>2020 — 2023</span>
        </div>
        <div class="work-dark-group__grid" data-reveal>
          {items.slice(3, 5).map((item, i) => (
            <a
              href={`/shipped/${item.id}/`}
              class:list={['work-dark-group__item', { 'work-dark-group__item--offset': i === 1 }]}
              data-card
              data-cat={item.data.category}
            >
              <PlaceholderMedia
                label={`${item.data.title} · headset capture`}
                src={item.data.heroImage}
                alt={item.data.heroAlt}
                ratio="4/3"
                radius="md"
                dark
              />
              <div class="work-dark-group__copy">
                <div class="work-dark-group__title">{item.data.title}</div>
                <div class="work-dark-group__tagline">{item.data.tagline}</div>
                <p class="work-dark-group__desc">{item.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="container shipped-takeaways">
    <div class="shipped-takeaways__intro" data-reveal>
      <div>
        <div class="mono-label" style="margin-bottom:24px">What these projects taught</div>
        <h2 class="shipped-takeaways__heading">What shipping teaches you that prototypes never will.</h2>
      </div>
    </div>
    <div class="shipped-takeaways__rows" data-reveal>
      {takeaways.map((item) => (
        <div class="shipped-takeaways__row">
          <span class="mono-label" style="color:var(--color-label-dim)">{item.n}</span>
          <h3 class="shipped-takeaways__title">{item.title}</h3>
          <p class="shipped-takeaways__copy">{item.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <FinalCTA />
</BaseLayout>

<style>
  .work-filter {
    padding-top: clamp(40px, 6vh, 72px);
  }

  .work-rows { padding-top: clamp(60px, 9vh, 120px); display: flex; flex-direction: column; gap: clamp(60px, 9vh, 120px); }
  .work-row { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 72px); align-items: center; }
  .work-row--dark { background: var(--color-dark-bg); color: var(--color-dark-fg); border-radius: var(--radius-xl); padding: clamp(36px, 5vw, 64px); }
  .work-row__copy { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .work-row__natural-image { display: block; width: 100%; height: auto; border-radius: var(--radius-md); }
  .work-row__title { margin: 0; font-size: clamp(30px, 3.6vw, 52px); line-height: .98; letter-spacing: -.035em; font-weight: 500; }
  .work-row__tagline { font-size: 17px; font-weight: 500; }
  .work-row__desc { margin: 0; max-width: 42ch; font-size: 16px; line-height: 1.6; color: var(--color-body); }
  .work-row--dark .work-row__desc { color: rgba(243, 242, 240, .62); }
  .work-row__tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .work-row__link { display: inline-flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 500; border-bottom: 1px solid var(--color-border-strong); padding-bottom: 4px; align-self: flex-start; margin-top: 4px; }
  .work-row--dark .work-row__link { border-bottom-color: rgba(243, 242, 240, .3); }
  @media (max-width: 900px) { .work-row { grid-template-columns: minmax(0, 1fr); row-gap: 20px; } }
  .work-showreel {
    padding-top: clamp(80px, 11vh, 150px);
  }

  .work-showreel__intro {
    display: grid;
    grid-template-columns: minmax(0, .5fr) minmax(0, 1.5fr);
    gap: clamp(24px, 4vw, 72px);
    align-items: end;
    margin-bottom: 30px;
  }

  .work-showreel__heading {
    margin: 0;
    font-size: clamp(26px, 3.2vw, 50px);
    line-height: 1.04;
    letter-spacing: -.035em;
    font-weight: 500;
    max-width: 36ch;
  }

  .work-dark-group {
    margin-top: clamp(80px, 12vh, 160px);
    background: var(--color-dark-bg);
    color: var(--color-dark-fg);
    padding: clamp(64px, 10vh, 140px) 0;
  }

  .work-dark-group__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(36px, 6vh, 72px);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--color-dark-label);
  }

  .work-dark-group__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 48px);
  }

  .work-dark-group__item {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .work-dark-group__item--offset {
    padding-top: clamp(0px, 6vw, 90px);
  }

  .work-dark-group__title {
    font-size: clamp(24px, 2.4vw, 38px);
    font-weight: 500;
    letter-spacing: -.035em;
  }

  .work-dark-group__tagline {
    font-size: 17px;
    color: rgba(243, 242, 240, .62);
  }

  .work-dark-group__desc {
    margin: 0;
    max-width: 40ch;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(243, 242, 240, .5);
  }

  .shipped-takeaways {
    padding-top: clamp(90px, 13vh, 180px);
  }

  .shipped-takeaways__intro {
    margin-bottom: clamp(36px, 5vh, 64px);
  }

  .shipped-takeaways__heading {
    margin: 0;
    font-size: clamp(34px, 5vw, 80px);
    line-height: .94;
    letter-spacing: -.045em;
    font-weight: 500;
    max-width: 18ch;
  }

  .shipped-takeaways__rows {
    border-top: 1px solid var(--color-border);
  }

  .shipped-takeaways__row {
    display: grid;
    grid-template-columns: 90px minmax(0, 1.05fr) minmax(0, 1.1fr);
    gap: 24px;
    align-items: baseline;
    padding: 30px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .shipped-takeaways__title {
    margin: 0;
    font-size: clamp(22px, 2.4vw, 38px);
    font-weight: 500;
    letter-spacing: -.03em;
    line-height: 1.05;
    max-width: 18ch;
  }

  .shipped-takeaways__copy {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-body);
    max-width: 46ch;
  }

  @media (max-width: 900px) {
    .work-showreel__intro,
    .work-dark-group__grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 18px;
    }


    .work-dark-group__item--offset {
      padding-top: 0;
    }

    .shipped-takeaways__row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 10px;
    }
  }
</style>
