---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingHero from '../../components/content/ListingHero.astro';
import FilterBar from '../../components/ui/FilterBar.astro';
import CompareSlider from '../../components/ui/CompareSlider.astro';
import PlaceholderMedia from '../../components/ui/PlaceholderMedia.astro';
import VideoReveal from '../../components/ui/VideoReveal.astro';
import Ticker from '../../components/ui/Ticker.astro';
import FinalCTA from '../../components/ui/FinalCTA.astro';

const all = await getCollection('lab', ({ data }) => !data.draft);
const bySlug = (slug: string) => all.find((item) => item.id === slug)!;

const exp01 = bySlug('consistent-character-workflows');
const exp07 = bySlug('ltx-video-experiments');

const featuredOrder = [
  { slug: 'realtime-drive-through-ordering', span: 4, ratio: '16/9', offset: false },
  { slug: 'modular-2d-characters', span: 2, ratio: '3/4', offset: true },
  { slug: 'concept-to-3d-asset', span: 2, ratio: '1/1', offset: false, dark: true },
  { slug: 'local-ai-versus-cloud', span: 2, ratio: '1/1', offset: false },
  { slug: 'modular-environment-kits', span: 2, ratio: '1/1', offset: false },
];

const labLogOrder = ['ltx-video-experiments', 'modular-environment-kits', 'local-ai-versus-cloud', 'concept-to-3d-asset', 'realtime-drive-through-ordering'];

const categories = ['Generative imagery', 'Voice and real-time', '3D and assets', 'Infrastructure'];
---

<BaseLayout title="AI Lab" description="Short experiments at the edge of the toolkit — generative imagery, real-time voice, 3D pipelines and the unglamorous infrastructure questions underneath them." current="ai-lab">
  <ListingHero
    eyebrowTop="KERRZO AI Lab"
    heading="Testing what is becoming possible."
    headingSize="clamp(46px, 9.2vw, 158px)"
    eyebrow="Open experiments"
    meta="Unfinished on purpose. Published as they are, notes included."
    lede="Short experiments at the edge of the toolkit — generative imagery, real-time voice, 3D pipelines and the unglamorous infrastructure questions underneath them."
  />

  <div class="lab-page__ticker">
    <Ticker text="ComfyUI · Flux · LTX Video · SDXL · Whisper · Realtime voice · Blender · TripoSR · Ollama · Llama · Claude · Vector DBs" />
  </div>

  <section class="container lab-page__filter">
    <FilterBar categories={categories} allLabel="All experiments" bordered={false} />
  </section>

  {exp01 && (
    <section class="container lab-page__exp01" data-card data-cat={exp01.data.category}>
      <div class="lab-page__exp01-meta" data-reveal>
        <span class="lab-page__exp01-meta-left"><span class="dot" aria-hidden="true"></span>EXP 01 &mdash; {exp01.data.title}</span>
        <span>Drag to compare</span>
      </div>
      <CompareSlider beforeLabel="Before · raw generation" afterLabel="After · locked character sheet" />
      <div class="lab-page__exp01-grid" data-reveal>
        <h2 class="lab-page__exp01-heading">Keeping one character consistent across four hundred generations</h2>
        <p class="body-copy lab-page__exp01-copy">{exp01.data.description}</p>
      </div>
    </section>
  )}

  <section class="container lab-page__grid-wrap">
    <div class="lab-page__grid" data-reveal data-narrow="repeat(2,minmax(0,1fr))">
      {featuredOrder.map((entry, i) => {
        const item = bySlug(entry.slug);
        return (
          <a
            href={`/ai-lab/${item.id}/`}
            class:list={['lab-page__grid-item', `lab-page__grid-item--span-${entry.span}`, { 'lab-page__grid-item--offset': entry.offset }]}
            data-card
            data-cat={item.data.category}
          >
            <PlaceholderMedia label={item.data.type} src={item.data.heroImage} alt={item.data.heroAlt} ratio={entry.ratio} radius="md" dark={entry.dark} />
            <div class="lab-page__grid-item-footer">
              <span class="lab-page__grid-item-title">{item.data.title}</span>
              <span class="mono-label" style="color:var(--color-label-dim)">EXP {String(i + 2).padStart(2, '0')}</span>
            </div>
            <span class="lab-page__grid-item-desc">{item.data.description}</span>
          </a>
        );
      })}
    </div>
  </section>

  {exp07 && (
    <section class="container lab-page__exp07" data-card data-cat={exp07.data.category}>
      <div class="lab-page__exp07-intro" data-reveal>
        <div class="mono-label">EXP 07 &mdash; {exp07.data.title}</div>
        <h2 class="lab-page__exp07-heading">Short generated sequences that hold together for longer than four seconds.</h2>
      </div>
      <VideoReveal />
    </section>
  )}

  <section class="lab-page__graph">
    <div class="container">
      <div class="lab-page__graph-intro" data-reveal>
        <div class="mono-label" style="color:var(--color-dark-label)">How it was made</div>
        <h2 class="lab-page__graph-heading">The graph behind EXP 01, in plain terms.</h2>
      </div>
      <div class="lab-page__graph-grid" data-reveal>
        <div class="lab-page__graph-steps">
          <div><span class="lab-page__graph-index">01</span>&nbsp; load reference sheet &rarr; face crop</div>
          <div><span class="lab-page__graph-index">02</span>&nbsp; ip-adapter · weight 0.62</div>
          <div><span class="lab-page__graph-index">03</span>&nbsp; character LoRA · 1400 steps</div>
          <div><span class="lab-page__graph-index">04</span>&nbsp; prompt schema: [pose] [outfit] [lighting]</div>
          <div><span class="lab-page__graph-index">05</span>&nbsp; seed sweep 8 &rarr; pick 1, upscale ×2</div>
          <div><span class="lab-page__graph-index">06</span>&nbsp; manual pass: hands, silhouette, palette</div>
        </div>
        <div class="lab-page__graph-side">
          <p>
            Nothing here is exotic. The value is in the constraints: a fixed prompt schema, a
            small trained model, and a human pass that only fixes the four things the model
            reliably gets wrong.
          </p>
          <div class="lab-page__graph-tags">
            <span class="pill-tag pill-tag--dark">ComfyUI</span>
            <span class="pill-tag pill-tag--dark">Flux</span>
            <span class="pill-tag pill-tag--dark">LoRA training</span>
            <span class="pill-tag pill-tag--dark">Photoshop</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container lab-page__log">
    <div class="lab-page__log-intro" data-reveal>
      <h2 class="lab-page__log-heading">Lab log</h2>
      <span class="mono-label">Updated weekly</span>
    </div>
    <div class="lab-page__log-rows" data-reveal>
      {labLogOrder.map((slug) => {
        const item = bySlug(slug);
        return (
          <a href={`/ai-lab/${item.id}/`} class="lab-page__log-row" data-narrow="minmax(0,1fr) 110px">
            <span class="mono-label" style="color:var(--color-label-dim)">{String(item.data.displayOrder).padStart(2, '0')}</span>
            <span class="lab-page__log-title">{item.data.title}</span>
            <span class="lab-page__log-tools">{item.data.tools.join(' · ')}</span>
            <span class="lab-page__log-status">{item.data.status}</span>
          </a>
        );
      })}
    </div>
  </section>

  <FinalCTA heading="Want one of these pointed at your problem?" />
</BaseLayout>

<style>
  .lab-page__ticker {
    padding-top: clamp(44px, 7vh, 80px);
  }

  .lab-page__filter {
    padding-top: clamp(48px, 7vh, 90px);
  }

  .lab-page__exp01 {
    padding-top: clamp(20px, 3vh, 40px);
  }

  .lab-page__exp01-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--color-label);
  }

  .lab-page__exp01-meta-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .lab-page__exp01-meta-left .dot {
    width: 6px;
    height: 6px;
  }

  .lab-page__exp01-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    margin-top: 28px;
  }

  .lab-page__exp01-heading {
    margin: 0;
    font-size: clamp(26px, 3.2vw, 48px);
    line-height: 1.02;
    letter-spacing: -.035em;
    font-weight: 500;
    max-width: 18ch;
  }

  .lab-page__exp01-copy {
    margin: 0;
    max-width: 44ch;
    padding-top: 6px;
  }

  .lab-page__grid-wrap {
    padding-top: clamp(64px, 9vh, 120px);
  }

  .lab-page__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 30px);
  }

  .lab-page__grid-item {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .lab-page__grid-item--span-4 { grid-column: span 4; }
  .lab-page__grid-item--span-2 { grid-column: span 2; }
  .lab-page__grid-item--offset { padding-top: clamp(0px, 4vw, 64px); }

  .lab-page__grid-item-footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .lab-page__grid-item-title {
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -.02em;
  }

  .lab-page__grid-item-desc {
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-body);
    max-width: 52ch;
  }

  .lab-page__exp07 {
    padding-top: clamp(70px, 10vh, 130px);
  }

  .lab-page__exp07-intro {
    display: grid;
    grid-template-columns: minmax(0, .5fr) minmax(0, 1.5fr);
    gap: clamp(24px, 4vw, 72px);
    align-items: end;
    margin-bottom: 28px;
  }

  .lab-page__exp07-heading {
    margin: 0;
    font-size: clamp(26px, 3.2vw, 50px);
    line-height: 1.04;
    letter-spacing: -.035em;
    font-weight: 500;
    max-width: 22ch;
  }

  .lab-page__graph {
    margin-top: clamp(80px, 12vh, 160px);
    background: var(--color-dark-bg);
    color: var(--color-dark-fg);
    padding: clamp(64px, 10vh, 140px) 0;
  }

  .lab-page__graph-intro {
    display: grid;
    grid-template-columns: minmax(0, .5fr) minmax(0, 1.5fr);
    gap: clamp(24px, 4vw, 72px);
    align-items: end;
    margin-bottom: clamp(34px, 5vh, 64px);
  }

  .lab-page__graph-heading {
    margin: 0;
    font-size: clamp(26px, 3.2vw, 50px);
    line-height: 1.04;
    letter-spacing: -.035em;
    font-weight: 500;
    max-width: 20ch;
  }

  .lab-page__graph-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
  }

  .lab-page__graph-steps {
    border: 1px solid var(--color-dark-border);
    border-radius: var(--radius-lg);
    padding: 26px 28px;
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 2;
    color: rgba(243, 242, 240, .78);
    overflow-x: auto;
  }

  .lab-page__graph-index {
    color: var(--color-accent);
  }

  .lab-page__graph-side {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .lab-page__graph-side p {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: rgba(243, 242, 240, .66);
  }

  .lab-page__graph-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .lab-page__log {
    padding-top: clamp(80px, 11vh, 150px);
  }

  .lab-page__log-intro {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 26px;
  }

  .lab-page__log-heading {
    margin: 0;
    font-size: clamp(28px, 3.2vw, 50px);
    line-height: 1;
    letter-spacing: -.04em;
    font-weight: 500;
  }

  .lab-page__log-rows {
    border-top: 1px solid var(--color-border);
  }

  .lab-page__log-row {
    display: grid;
    grid-template-columns: 70px minmax(0, 1.2fr) minmax(0, 1fr) 130px;
    gap: 20px;
    align-items: baseline;
    padding: 22px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .lab-page__log-title {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -.02em;
  }

  .lab-page__log-tools {
    font-family: var(--font-mono);
    font-size: 12px;
    color: #7c7973;
  }

  .lab-page__log-status {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--color-label);
    text-align: right;
  }

  @media (max-width: 900px) {
    .lab-page__exp01-grid,
    .lab-page__exp07-intro,
    .lab-page__graph-intro,
    .lab-page__graph-grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 18px;
    }

    .lab-page__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .lab-page__grid-item--span-4,
    .lab-page__grid-item--span-2 {
      grid-column: span 1;
    }

    .lab-page__grid-item--offset {
      padding-top: 0;
    }

    .lab-page__log-row {
      grid-template-columns: minmax(0, 1fr) 110px;
      row-gap: 6px;
    }

    .lab-page__log-tools {
      display: none;
    }
  }
</style>
