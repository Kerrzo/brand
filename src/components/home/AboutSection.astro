---
import PlaceholderMedia from '../ui/PlaceholderMedia.astro';
---

<section id="about" class="about-teaser container">
  <div class="about-teaser__grid" data-reveal>
    <PlaceholderMedia label="Portrait of Paul · editorial, natural light" ratio="4/5" radius="md" class="about-teaser__media" />
    <div class="about-teaser__copy">
      <h2 class="about-teaser__heading">Experience still matters.</h2>
      <p class="body-copy about-teaser__lede">
        I have spent more than 25 years designing, building and leading digital products across
        commerce, property, strategy, healthcare, immersive technology and AI.
      </p>
      <p class="body-copy">
        The tools have changed dramatically. Product judgement, technical clarity and the ability
        to turn complexity into something useful have not.
      </p>
      <a href="/about/" class="about-teaser__link">More about Paul &rarr;</a>
    </div>
  </div>
</section>

<style>
  .about-teaser {
    padding-top: clamp(90px, 13vh, 180px);
  }

  .about-teaser__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(28px, 5vw, 90px);
    align-items: start;
  }

  .about-teaser__copy {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: clamp(0px, 3vw, 48px);
  }

  .about-teaser__heading {
    margin: 0;
    font-size: clamp(36px, 5vw, 80px);
    line-height: .94;
    letter-spacing: -.045em;
    font-weight: 500;
  }

  .about-teaser__lede {
    max-width: 48ch;
    font-size: 18px;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }

  .about-teaser__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 500;
    border-bottom: 1px solid var(--color-border-strong);
    padding-bottom: 4px;
    align-self: flex-start;
  }

  @media (max-width: 900px) {
    .about-teaser__grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 24px;
    }
  }
</style>
