---
import { getCollection } from 'astro:content';
import SectionLabel from '../ui/SectionLabel.astro';
import PlaceholderMedia from '../ui/PlaceholderMedia.astro';

const all = await getCollection(
  'work',
  ({ data }) => !data.draft && ['Immersive technology', 'Health and wellbeing'].includes(data.category)
);
const items = all.sort((a, b) => a.data.displayOrder - b.data.displayOrder);
---

<section class="emerging">
  <div class="container">
    <SectionLabel dark data-reveal>Emerging technology</SectionLabel>
    <h2 class="emerging__heading" data-reveal>I have been building beyond the conventional screen for years.</h2>
    <div class="emerging__grid" data-reveal>
      {items.map((item, i) => (
        <a href={`/work/${item.id}/`} class:list={['emerging__item', { 'emerging__item--offset': i % 2 === 1 }]}>
          <PlaceholderMedia label={`${item.data.title} · headset capture`} ratio="4/3" radius="md" dark />
          <div class="emerging__item-copy">
            <div class="emerging__item-title">{item.data.title}</div>
            <div class="emerging__item-tagline">{item.data.tagline}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .emerging {
    margin-top: clamp(90px, 13vh, 180px);
    background: var(--color-dark-bg);
    color: var(--color-dark-fg);
    padding: clamp(70px, 11vh, 150px) 0;
  }

  .emerging__heading {
    margin: 0 0 clamp(44px, 7vh, 96px);
    font-size: clamp(34px, 4.8vw, 78px);
    line-height: .96;
    letter-spacing: -.045em;
    font-weight: 500;
    max-width: 20ch;
  }

  .emerging__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 48px);
  }

  .emerging__item {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .emerging__item--offset {
    padding-top: clamp(0px, 6vw, 90px);
  }

  .emerging__item-copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .emerging__item-title {
    font-size: clamp(22px, 2.2vw, 34px);
    font-weight: 500;
    letter-spacing: -.03em;
  }

  .emerging__item-tagline {
    font-size: 16px;
    color: rgba(243, 242, 240, .6);
  }

  @media (max-width: 900px) {
    .emerging__grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 32px;
    }

    .emerging__item--offset {
      padding-top: 0;
    }
  }
</style>
