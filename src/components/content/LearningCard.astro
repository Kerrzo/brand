---
import type { CollectionEntry } from 'astro:content';
import PlaceholderMedia from '../ui/PlaceholderMedia.astro';
import { readingTime } from '../../lib/readingTime';
interface Props { post: CollectionEntry<'writing'>; }
const { post } = Astro.props;
const date = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' });
---
<a class="learning-card" href={`/learnings/${post.id}/`} data-card data-cat={post.data.category}>
  <PlaceholderMedia label="Article image" src={post.data.heroImage} alt={post.data.heroAlt} ratio={post.data.heroRatio ?? '16/10'} radius="md" />
  <div class="learning-card__copy">
    <span class="mono-label">{post.data.category}</span>
    <h3>{post.data.title}</h3>
    <p class="body-copy">{post.data.description}</p>
    <div class="mono-label"><time datetime={post.data.publishedDate.toISOString()}>{date.format(post.data.publishedDate)}</time> · {readingTime(post.body ?? '')}</div>
  </div>
</a>
<style>
  .learning-card { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: var(--editorial-gap); align-items: center; padding-block: 36px; border-top: 1px solid var(--color-border); }
  .learning-card__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .learning-card h3 { margin: 0; font-size: clamp(24px, 2.7vw, 38px); line-height: 1.08; font-weight: 500; letter-spacing: -.03em; max-width: 26ch; }
  .learning-card p { margin: 0; max-width: 52ch; }
  @media (max-width: 640px) { .learning-card { grid-template-columns: minmax(0, 1fr); gap: 24px; } }
</style>
