<figure class="shoe-viewer">
  <div class="shoe-stage" role="img" aria-label="Interactive untextured Kai boot model"></div>
  <div class="shoe-controls"><button type="button" data-load>Explore the shoe in 3D</button><button type="button" data-wire hidden aria-pressed="false">Wireframe</button><button type="button" data-reset hidden>Reset view</button><span role="status">Load the model to inspect its geometry.</span></div>
  <figcaption>Kai / Shoe geometry. Neutral material preview; the material guide above is a separate reference. Drag to orbit · scroll or pinch to zoom.</figcaption>
</figure>
<script>
  import './kai-shoe-viewer';
</script>
<style>
.shoe-viewer{margin:48px 0 0}.shoe-stage{aspect-ratio:4/3;background:#171918;border-radius:12px;overflow:hidden}.shoe-stage :global(canvas){display:block;width:100%;height:100%;touch-action:pan-y}.shoe-controls{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-top:18px}.shoe-controls button{font:inherit;padding:10px 18px;border:1px solid currentColor;border-radius:24px;background:transparent;color:inherit;cursor:pointer}.shoe-controls button[aria-pressed=true]{background:#e95027;color:white}.shoe-controls span,figcaption{font-size:14px;line-height:1.5;opacity:.65}figcaption{margin-top:16px;max-width:65ch}.shoe-controls [hidden]{display:none}
</style>