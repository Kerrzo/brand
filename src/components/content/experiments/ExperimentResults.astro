---
interface Props { tests: { name: string; status: string; result?: string }[] }
const { tests } = Astro.props;
---
<ol class="experiment-results" aria-label="Experiment test status">
  {tests.map((test, i) => <li><span class="mono-label">Test {String(i + 1).padStart(2, '0')}</span><strong>{test.name}</strong><span class="mono-label">Status / {test.status}</span>{test.result && <p>{test.result}</p>}</li>)}
</ol>
<style>
  .experiment-results { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-border); }
  li { display: grid; grid-template-columns: 80px 1fr auto; gap: 16px; align-items: baseline; padding: 20px 0; border-bottom: 1px solid var(--color-border); }
  strong { font-size: 18px; font-weight: 500; } p { grid-column: 2 / -1; }
  @media(max-width: 600px) { li { grid-template-columns: 1fr; gap: 8px; } p { grid-column: 1; } }
</style>
