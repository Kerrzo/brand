---
interface Item {
  title: string;
  copy?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ol class="article-learnings">
  {items.map((item, i) => (
    <li class="article-learnings__item">
      <span class="article-learnings__index">{String(i + 1).padStart(2, '0')}</span>
      <div class="article-learnings__body">
        <h3 class="article-learnings__title">{item.title}</h3>
        {item.copy && <p class="article-learnings__copy">{item.copy}</p>}
      </div>
    </li>
  ))}
</ol>

<style>
  .article-learnings {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .article-learnings__item {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr);
    gap: 20px;
    padding: 30px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .article-learnings__index {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-label);
  }

  .article-learnings__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .article-learnings__title {
    margin: 0;
    font-size: clamp(20px, 2.2vw, 30px);
    font-weight: 500;
    letter-spacing: -.03em;
    line-height: 1.1;
  }

  .article-learnings__copy {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-body);
    max-width: 56ch;
  }

  /* Dark article sections (e.g. Learning's "What I learned") hardcode
     light-mode colors above — repoint them here the same way ArticleSection
     already does for .body-copy/.mono-label. */
  :global(.article-section--dark) .article-learnings {
    border-top-color: var(--color-dark-border);
  }

  :global(.article-section--dark) .article-learnings__item {
    border-bottom-color: var(--color-dark-border);
  }

  :global(.article-section--dark) .article-learnings__index {
    color: var(--color-dark-label);
  }

  :global(.article-section--dark) .article-learnings__copy {
    color: rgba(243, 242, 240, .55);
  }
</style>
