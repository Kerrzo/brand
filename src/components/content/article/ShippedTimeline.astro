---
// Editorial evolution timeline for Shipped case studies — deliberately distinct
// from the Learnings ArticlePipeline (chips + arrows): a vertical rule with a
// marker per milestone, read top to bottom as a chronology rather than a
// left-to-right process. No cards, icons or numbering — just the rule, the
// marker and the title.
interface Props {
  milestones: string[];
  class?: string;
}

const { milestones, class: className = '' } = Astro.props;
---

<ol class:list={['shipped-timeline', className]}>
  {milestones.map((m) => (
    <li class="shipped-timeline__item">
      <span class="shipped-timeline__marker" aria-hidden="true"></span>
      <span class="shipped-timeline__label">{m}</span>
    </li>
  ))}
</ol>

<style>
  .shipped-timeline {
    position: relative;
    margin: 0;
    padding: 0 0 0 28px;
    list-style: none;
    border-left: 1px solid var(--color-border);
  }

  .shipped-timeline__item {
    position: relative;
    padding: 22px 0;
  }

  .shipped-timeline__item:first-child {
    padding-top: 0;
  }

  .shipped-timeline__item:last-child {
    padding-bottom: 0;
  }

  .shipped-timeline__marker {
    position: absolute;
    left: -32.5px;
    top: 22px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-ink);
  }

  .shipped-timeline__item:first-child .shipped-timeline__marker {
    top: 0;
  }

  .shipped-timeline__label {
    display: block;
    font-size: clamp(17px, 1.8vw, 22px);
    font-weight: 500;
    letter-spacing: -.02em;
    line-height: 1.3;
  }

  :global(.article-section--dark) .shipped-timeline {
    border-left-color: var(--color-dark-border);
  }

  :global(.article-section--dark) .shipped-timeline__marker {
    background: var(--color-dark-fg);
  }

  @media (max-width: 900px) {
    .shipped-timeline__item {
      padding: 16px 0;
    }

    .shipped-timeline__marker {
      top: 16px;
    }

    .shipped-timeline__item:first-child .shipped-timeline__marker {
      top: 0;
    }
  }
</style>
