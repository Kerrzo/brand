---
interface Props {
  size?: 'lg' | 'xl';
  align?: 'left' | 'center';
  maxWidth?: string;
  class?: string;
}

const { size = 'lg', align = 'left', maxWidth, class: className = '' } = Astro.props;
---

<p
  class:list={['article-statement', `article-statement--${size}`, `article-statement--${align}`, className]}
  style={maxWidth ? { maxWidth } : undefined}
>
  <slot />
</p>

<style>
  .article-statement {
    margin: 0;
    font-weight: 500;
    letter-spacing: -0.045em;
  }

  .article-statement--lg {
    font-size: clamp(28px, 4vw, 52px);
    line-height: 1.12;
    max-width: 22ch;
  }

  .article-statement--xl {
    font-size: clamp(38px, 6.4vw, 88px);
    line-height: 1.02;
    max-width: 16ch;
  }

  .article-statement--center {
    margin-inline: auto;
    text-align: center;
  }
</style>
