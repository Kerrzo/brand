---
// Narrow label/eyebrow column + wide content column — the same 0.5fr/1.5fr
// editorial split used elsewhere on the site (e.g. the About page).
interface Props {
  ratio?: string;
  class?: string;
}

const { ratio = 'minmax(0, .5fr) minmax(0, 1.5fr)', class: className = '' } = Astro.props;
---

<div class:list={['article-two-col', className]} style={{ gridTemplateColumns: ratio }}>
  <div class="article-two-col__label">
    <slot name="label" />
  </div>
  <div class="article-two-col__content">
    <slot />
  </div>
</div>

<style>
  .article-two-col {
    display: grid;
    gap: var(--editorial-gap);
    align-items: start;
  }

  .article-two-col__content {
    display: flex;
    flex-direction: column;
    gap: 0;
    min-width: 0;
  }

  /*
    Narrative measure spine: section headings sit on the same left edge as
    body copy, but at --heading-measure (~760px). Paragraphs keep
    --reading-measure (~64ch). Media / figures / CTAs are NOT capped here —
    they inherit the full content column so evidence can break wider.
    Heroes keep their own tighter title measures (e.g. BuildingHero h1).
    Display statements (EditorialScrollSequence, payoffs) live outside this.
  */
  .article-two-col__content > :global(:is(h2, .h-2)) {
    max-width: min(100%, var(--heading-measure));
  }

  /* Default beat between major blocks; body paragraphs sit tighter. */
  .article-two-col__content > :global(* + *) {
    margin-top: 30px;
  }

  .article-two-col__content > :global(p + p:not(.section-spacing-top):not(.section-spacing-top-lg):not(.prose-emphasis)) {
    margin-top: var(--prose-gap);
  }

  .article-two-col__content > :global(.section-spacing-top) {
    margin-top: 32px;
  }

  .article-two-col__content > :global(.section-spacing-top-lg) {
    margin-top: 48px;
  }

  .article-two-col__content > :global(.prose-emphasis) {
    margin-top: var(--prose-pause);
  }

  @media (max-width: 900px) {
    .article-two-col {
      grid-template-columns: minmax(0, 1fr) !important;
      row-gap: 20px;
    }
  }
</style>
