---
interface Item {
  question: string;
  answer: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="faq" data-reveal data-faq>
  {items.map((item, i) => (
    <div class="faq__item" data-faq-item>
      <button type="button" class="faq__trigger" data-faq-trigger aria-expanded={i === 0 ? 'true' : 'false'}>
        <span class="faq__index">{String(i + 1).padStart(2, '0')}</span>
        <span class="faq__question">{item.question}</span>
        <span class="faq__arrow" data-faq-arrow aria-hidden="true">&darr;</span>
      </button>
      <div class="faq__answer" data-faq-answer hidden={i !== 0}>
        <p>{item.answer}</p>
      </div>
    </div>
  ))}
</div>

<style>
  .faq {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq__item {
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg-warm);
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }

  .faq__item:has([aria-expanded="true"]) {
    background: #ffffff;
    border-color: rgba(14, 14, 13, .3);
  }

  .faq__trigger {
    width: 100%;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) 30px;
    gap: 16px;
    align-items: center;
    padding: 22px 24px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    color: inherit;
  }

  .faq__index {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-label-dim);
  }

  .faq__question {
    font-size: 17px;
    font-weight: 500;
  }

  .faq__arrow {
    justify-self: end;
    font-size: 16px;
    transition: transform .3s ease;
  }

  .faq__trigger[aria-expanded="true"] .faq__arrow {
    transform: rotate(180deg);
  }

  .faq__answer {
    padding: 0 24px 22px 96px;
  }

  .faq__answer p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-body);
    max-width: 60ch;
  }

  @media (max-width: 640px) {
    .faq__trigger {
      grid-template-columns: 34px minmax(0, 1fr) 24px;
    }

    .faq__answer {
      padding-left: 24px;
    }
  }
</style>

<script>
  function initFaq() {
    document.querySelectorAll<HTMLElement>('[data-faq]').forEach((faq) => {
      if (faq.dataset.bound) return;
      faq.dataset.bound = '1';

      const items = Array.from(faq.querySelectorAll<HTMLElement>('[data-faq-item]'));

      items.forEach((item) => {
        const trigger = item.querySelector<HTMLButtonElement>('[data-faq-trigger]');
        const answer = item.querySelector<HTMLElement>('[data-faq-answer]');
        trigger?.addEventListener('click', () => {
          const isOpen = trigger.getAttribute('aria-expanded') === 'true';
          items.forEach((other) => {
            const otherTrigger = other.querySelector<HTMLButtonElement>('[data-faq-trigger]');
            const otherAnswer = other.querySelector<HTMLElement>('[data-faq-answer]');
            otherTrigger?.setAttribute('aria-expanded', 'false');
            if (otherAnswer) otherAnswer.hidden = true;
          });
          if (!isOpen) {
            trigger.setAttribute('aria-expanded', 'true');
            if (answer) answer.hidden = false;
          }
        });
      });
    });
  }

  initFaq();
</script>
