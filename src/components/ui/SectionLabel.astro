---
interface Props {
  dark?: boolean;
  withDot?: boolean;
  class?: string;
}

const { dark = false, withDot = false, class: className = '' } = Astro.props;
---

<div class:list={['section-label', { 'section-label--dark': dark }, className]}>
  {withDot && <span class="dot" aria-hidden="true"></span>}
  <slot />
</div>

<style>
  .section-label {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--color-label);
  }

  .section-label--dark {
    color: var(--color-dark-label);
  }

  /* Auto-adapt when nested inside a dark ArticleSection, so toggling a
     chapter's dark prop is enough on its own — callers don't also have to
     remember to pass `dark` to every child component by hand. The explicit
     `dark` prop above still works for SectionLabel used outside that
     context (e.g. a page hero). */
  :global(.article-section--dark) .section-label {
    color: var(--color-dark-label);
  }
</style>
