---
interface Props {
  categories: string[];
  allLabel?: string;
  bordered?: boolean;
}

const { categories, allLabel = 'All', bordered = true } = Astro.props;
---

<div class:list={['filter-bar', { 'filter-bar--bordered': bordered }]} data-reveal data-filter-bar data-all-label={allLabel}>
  <button type="button" class="filter-bar__btn is-active" data-filter-btn data-filter={allLabel}>
    {allLabel}
  </button>
  {categories.map((cat) => (
    <button type="button" class="filter-bar__btn" data-filter-btn data-filter={cat}>
      {cat}
    </button>
  ))}
  <span class="filter-bar__count" data-filter-count>Showing all</span>
</div>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    padding-bottom: 24px;
  }

  .filter-bar--bordered {
    border-bottom: 1px solid var(--color-border);
  }

  .filter-bar__btn {
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-strong);
    background: transparent;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    flex: 0 0 auto;
    color: var(--color-ink);
  }

  .filter-bar__btn.is-active {
    background: var(--color-ink);
    color: var(--color-bg);
    border-color: var(--color-ink);
  }

  .filter-bar__count {
    margin-left: auto;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-label);
  }
</style>

<script>
  function initFilterBars() {
    document.querySelectorAll<HTMLElement>('[data-filter-bar]').forEach((bar) => {
      if (bar.dataset.bound) return;
      bar.dataset.bound = '1';

      const allLabel = bar.dataset.allLabel || 'All';
      const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-filter-btn]'));
      const countEl = bar.querySelector<HTMLElement>('[data-filter-count]');
      const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
      const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-card-group]'));
      const nounSingular = bar.dataset.noun || 'item';
      const nounPlural = bar.dataset.nounPlural || `${nounSingular}s`;

      const applyFilter = (cat: string) => {
        buttons.forEach((b) => b.classList.toggle('is-active', b.dataset.filter === cat));
        let n = 0;
        cards.forEach((card) => {
          const show = cat === allLabel || card.dataset.cat === cat;
          card.style.display = show ? '' : 'none';
          if (show) n++;
        });
        groups.forEach((group) => {
          const anyVisible = Array.from(group.querySelectorAll<HTMLElement>('[data-card]')).some(
            (c) => c.style.display !== 'none'
          );
          group.style.display = anyVisible ? '' : 'none';
        });
        if (countEl) {
          countEl.textContent = cat === allLabel ? `Showing all ${n}` : `${n} ${n === 1 ? nounSingular : nounPlural}`;
        }
      };

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => applyFilter(btn.dataset.filter || allLabel));
      });
    });
  }

  initFilterBars();
</script>
