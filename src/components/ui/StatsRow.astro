---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<div class="stats-row" data-reveal>
  {stats.map((stat) => (
    <div class="stats-row__cell">
      <div class="stats-row__value">{stat.value}</div>
      <div class="stats-row__label">{stat.label}</div>
    </div>
  ))}
</div>

<style>
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .stats-row__cell {
    padding: 34px 26px;
    border-right: 1px solid var(--color-border);
  }

  .stats-row__cell:first-child {
    padding-left: 0;
  }

  .stats-row__cell:last-child {
    border-right: none;
    padding-right: 0;
  }

  .stats-row__value {
    font-size: clamp(20px, 1.8vw, 34px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .stats-row__label {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--color-label);
  }

  @media (max-width: 900px) {
    .stats-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 18px;
    }

    .stats-row__cell {
      border-right: none;
      padding: 20px 16px;
    }

    .stats-row__cell:nth-child(odd) {
      padding-left: 0;
      border-right: 1px solid var(--color-border);
    }
  }
</style>
