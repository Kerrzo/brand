---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div class="ticker" data-reveal>
  <div class="ticker-track">
    <span class="ticker__text">{text}&nbsp;&middot;&nbsp;</span>
    <span class="ticker__text">{text}&nbsp;&middot;&nbsp;</span>
  </div>
</div>

<style>
  .ticker {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
    white-space: nowrap;
    padding: 18px 0;
  }

  .ticker__text {
    padding-right: 1.5em;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: #7c7973;
  }
</style>
