---
interface Props {
  text: string;
}

const { text } = Astro.props;
const segment = `${text} · `;
// Enough repeats per half that the track stays wider than the viewport
const half = Array.from({ length: 6 }, () => segment).join('');
---

<div class="ticker" data-reveal>
  <div class="ticker-track">
    <span class="ticker__text">{half}</span>
    <span class="ticker__text" aria-hidden="true">{half}</span>
  </div>
</div>

<style>
  .ticker {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
    white-space: nowrap;
    padding: 18px 0;
  }

  .ticker-track {
    display: flex;
    width: max-content;
  }

  .ticker__text {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #7c7973;
  }
</style>
